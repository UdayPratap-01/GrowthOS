# Shared
# DEMO_MODE=true forces DEMO operating mode (seed OK for local). Set false for LIVE.
# Org demo flag can also be toggled in Settings. Effective mode = org OR env.
DEMO_MODE=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Prefer Postgres in production / with Docker:
# DATABASE_URL=postgresql+asyncpg://growthos:growthos@localhost:5432/growthos
# DATABASE_URL_SYNC=postgresql://growthos:growthos@localhost:5432/growthos
# Local fallback without Docker:
DATABASE_URL=sqlite+aiosqlite:///./growthos.db
DATABASE_URL_SYNC=sqlite:///./growthos.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
ENCRYPTION_KEY=change-me-32-byte-fernet-compatible-key!!
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
RATE_LIMIT_PER_MINUTE=120

# Public URLs (OAuth redirects)
API_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000

# Phase 3 — Meta family (Meta Ads / Instagram / WhatsApp)
META_APP_ID=
META_APP_SECRET=
# Optional override; default: {API_PUBLIC_URL}/api/v1/integrations/{provider}/callback
META_REDIRECT_URI=

# Phase 3 — Google Analytics (shared OAuth client for Ads / YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Phase 4 — Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional manager (MCC) customer id, digits only or with dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REDIRECT_URI=

# Phase 4 — YouTube (uses GOOGLE_CLIENT_ID/SECRET; optional redirect override)
YOUTUBE_REDIRECT_URI=

# Phase 5 — generation providers: none | demo
IMAGE_PROVIDER=none
VIDEO_PROVIDER=none
META_WEBHOOK_VERIFY_TOKEN=

# Web
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
